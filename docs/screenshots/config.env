# Checked-in config for the flows: no credentials. The ui step of the e2e
# suite (tests/e2e/ui.go) seeds the docs tenant and passes each user's Vault
# token (ALICE_TOKEN, BOB_TOKEN, DAVE_TOKEN) from a Secret.
#
# The lab's Vault, by its in-cluster name: the flows run in a Pod in the cluster.
VAULT_URL=http://vault.vault.svc:8200
# The docs tenant, its namespace and its app (tests/e2e/ui.go).
TENANT=acme
ENV_PATH=dev
APP_PATH=dev/acme-shop/checkout
# What acme-shop shares with the tenant's other namespaces.
SHARED_PATH=dev/_shared/from-acme-shop
# The SSO login: the tenant's OIDC mount, alice's role, and her Keycloak user.
SSO_MOUNT=oidc/sso
SSO_ROLE=sso.acme.editor
ALICE_USER=alice
# bob is in acme-viewers: his login with the editor role is refused.
BOB_USER=bob
# The app's secret db, as the UI's secret routes spell it: one path segment.
DB_SECRET=dev%2Facme-shop%2Fcheckout%2Fdb
